# DevCollab sandboxed execution runner - JavaScript/TypeScript.
# The server injects untrusted source via tar/STDIN; the container NEVER runs
# as root and provides no shell beyond what the language runtime needs.
FROM node:20-alpine

RUN addgroup -g 10001 sandbox && \
    adduser -S -u 10001 -G sandbox -h /home/sandbox sandbox && \
    mkdir -p /tmp /home/sandbox && \
    chmod 1777 /tmp && \
    chown 10001:10001 /home/sandbox

USER 10001:10001
WORKDIR /home/sandbox

# Execution entrypoint is chosen per-run by DevCollab's executor
# (node for JS, tsc for TS) - container itself stays minimal.
CMD ["node", "--interactive"]
