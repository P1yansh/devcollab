# DevCollab local demo defaults.
# All credentials below are local-only (localhost Docker containers) and are
# safe to ship inside the release zip. No production secrets belong here.

# --- Environment ------------------------------------------------------------
NODE_ENV=development

# --- REST / Socket.IO control channel ---------------------------------------
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Yjs CRDT channel (dedicated ws server) ---------------------------------
YJS_WS_PORT=4001

# --- Persistence ------------------------------------------------------------
DATABASE_URL=postgresql://devcollab:devcollab@localhost:5432/devcollab

# --- Cache / pubsub / scaling ------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Sandboxed execution ----------------------------------------------------
# POSIX default; the executor auto-detects //./pipe/docker_engine on Windows.
# Keep unset on Windows so detection runs, or set explicitly:
# DOCKER_SOCKET=//./pipe/docker_engine
EXECUTION_TIMEOUT_MS=7000
EXECUTION_MEMORY_BYTES=268435456
EXECUTION_CPU_QUOTA=500000000
EXECUTION_PIDS_LIMIT=64

# Execution backend: 'docker' (local Docker container), 'piston' (cloud API), or 'auto'
EXECUTION_BACKEND=docker
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# --- AI Copilot Sidecar -----------------------------------------------------
# Optional API key for OpenAI, Anthropic, or Gemini (if unset, built-in copilot responds)
AI_API_KEY=
# Optional. Key prefix selects the provider endpoint automatically:
#   AIza... -> Google Gemini  (default model: gemini-1.5-flash)
#   gsk_... -> Groq           (default model: openai/gpt-oss-20b)
#   other   -> OpenAI         (default model: gpt-4o-mini)
# If empty, the built-in local copilot engine is used instead.
AI_MODEL=

# --- Cloud Deployment -------------------------------------------------------
# When set to true, REST, Socket.IO, and Yjs WebSockets run on a single port (PORT)
SINGLE_PORT=false
