{
  "name": "@devcollab/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@devcollab/shared": "^0.1.0",
    "@prisma/client": "^5.19.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/ws": "^8.5.12",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "lib0": "^0.2.99",
    "prisma": "^5.19.1",
    "socket.io": "^4.7.5",
    "typescript": "^5.6.3",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.1"
  }
}
