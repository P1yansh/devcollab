{
  "name": "@devcollab/shared",
  "version": "0.1.0",
  "description": "Shared contracts, Zod schemas and Socket.IO event typings for DevCollab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
