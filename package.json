{
  "name": "@devcollab/monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/run.mjs setup-sandboxes",
    "package": "node scripts/run.mjs package-zip",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run --workspace=@devcollab/server db:generate",
    "db:deploy": "npm run --workspace=@devcollab/server db:deploy",
    "start": "node apps/server/dist/index.js"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {}
}
